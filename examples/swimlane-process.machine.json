{
  "id": "swimlane-process",
  "version": 1,
  "initial": "create_quote",
  "metadata": {
    "documentation": "Insurance application process with swimlanes",
    "lanes": {
      "Customer": ["create_quote", "submit_documents"],
      "Underwriter": ["review_application", "calculate_premium"],
      "System": ["policy_issued", "application_rejected"]
    }
  },
  "states": {
    "create_quote": {
      "id": "task_create_quote",
      "type": "task",
      "on": {
        "CREATE": {
          "id": "flow_create",
          "target": "submit_documents"
        }
      }
    },
    "submit_documents": {
      "id": "task_submit_documents",
      "type": "task",
      "on": {
        "SUBMIT": {
          "id": "flow_submit",
          "target": "review_application"
        }
      }
    },
    "review_application": {
      "id": "task_review_application",
      "type": "task",
      "on": {
        "APPROVE": {
          "id": "flow_approve",
          "target": "calculate_premium",
          "guard": "isUnderwriter"
        },
        "REJECT": {
          "id": "flow_reject",
          "target": "application_rejected",
          "guard": "isUnderwriter"
        }
      },
      "timers": [
        {
          "id": "timer_review_deadline",
          "type": "DURATION",
          "iso": "P30D",
          "event": "REVIEW_DEADLINE"
        }
      ]
    },
    "calculate_premium": {
      "id": "task_calculate_premium",
      "type": "task",
      "on": {
        "CALCULATE": {
          "id": "flow_calculate",
          "target": "policy_issued",
          "actions": ["generatePolicy", "sendNotification"]
        }
      }
    },
    "policy_issued": {
      "id": "end_policy_issued",
      "type": "end"
    },
    "application_rejected": {
      "id": "end_application_rejected",
      "type": "end"
    }
  }
}


