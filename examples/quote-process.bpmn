<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="process-editor" exporterVersion="1.0.0">
  <bpmn:process id="quote" isExecutable="true">
    <bpmn:task id="task_created" name="created" data-state-name="created" data-element-id="task_created" />
    <bpmn:task id="task_approved" name="approved" data-state-name="approved" data-element-id="task_approved" />
    <bpmn:task id="task_ready" name="ready_for_collection" data-state-name="ready_for_collection" data-element-id="task_ready" />
    <bpmn:endEvent id="end_paid" name="paid_full" data-element-id="end_paid" />
    
    <bpmn:sequenceFlow id="flow_approve" sourceRef="task_created" targetRef="task_approved" name="APPROVE" data-event="APPROVE" data-flow-id="flow_approve" data-guard="isReviewer" />
    <bpmn:sequenceFlow id="flow_ready" sourceRef="task_approved" targetRef="task_ready" name="READY_FOR_COLLECTION" data-event="READY_FOR_COLLECTION" data-flow-id="flow_ready" />
    <bpmn:sequenceFlow id="flow_pay" sourceRef="task_ready" targetRef="end_paid" name="PAY_FULL" data-event="PAY_FULL" data-flow-id="flow_pay" data-actions="recordPayment" />
    
    <bpmn:boundaryEvent id="timer_collection" attachedToRef="task_approved" name="COLLECTION_EXPIRED" data-timer-id="timer_collection" data-timer-type="DURATION" data-iso="P14D" data-event="COLLECTION_EXPIRED">
      <bpmn:timerEventDefinition />
    </bpmn:boundaryEvent>
  </bpmn:process>
  
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="quote">
      <bpmndi:BPMNShape id="BPMNShape_task_created" bpmnElement="task_created">
        <dc:Bounds x="100" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_task_approved" bpmnElement="task_approved">
        <dc:Bounds x="300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_task_ready" bpmnElement="task_ready">
        <dc:Bounds x="500" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end_paid" bpmnElement="end_paid">
        <dc:Bounds x="700" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_timer_collection" bpmnElement="timer_collection">
        <dc:Bounds x="380" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>


